# Copy these variables into a local shell or hosting dashboard. Never commit real values.
NEON_JDBC_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
NEON_DB_USER=YOUR_NEON_ROLE
NEON_DB_PASSWORD=YOUR_NEON_PASSWORD
SESSION_COOKIE_SECURE=false
MORROW_ADMIN_SQL_ENABLED=false
SERVER_PORT=8081
